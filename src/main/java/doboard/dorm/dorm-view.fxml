<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<VBox spacing="25" alignment="TOP_CENTER" prefWidth="400" prefHeight="500"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="doboard.dorm.DormController" style="-fx-background-color: #f4f4f4;">

    <padding>
        <Insets top="40" right="30" bottom="40" left="30"/>
    </padding>

    <Text text="Dorm Management" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #333;"/>

    <!-- Create Section -->
    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        <Label text="Setup New Dorm" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextField fx:id="dormNameField" promptText="Dorm Name (e.g. Baker Hall 302)"/>
        <Button text="Create &amp; Register" onAction="#handleCreateDorm"
                maxWidth="Infinity" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand;"/>
    </VBox>

    <HBox alignment="CENTER" spacing="10">
        <Separator HBox.hgrow="ALWAYS" style="-fx-padding: 10 0 0 0;"/>
        <Text text="OR" style="-fx-fill: #888;"/>
        <Separator HBox.hgrow="ALWAYS" style="-fx-padding: 10 0 0 0;"/>
    </HBox>

    <!-- Join Section -->
    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        <Label text="Join with Invitation" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextField fx:id="joinCodeField" promptText="6-Digit Join Code"/>
        <Button text="Join Existing Dorm" onAction="#handleJoinDorm"
                maxWidth="Infinity" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;"/>
    </VBox>

    <Label fx:id="statusLabel" wrapText="true" textAlignment="CENTER" style="-fx-font-size: 12px;"/>

</VBox>