<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="task-item"
    xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <ImageView fx:id="profileImage" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true"
               preserveRatio="true"/>
    <Label fx:id="usernameVal" text="Username"/>
    <Region prefHeight="21.0" prefWidth="0.0" HBox.hgrow="ALWAYS"/>
    <Label fx:id="choresCount" styleClass="text-md" text="[num]"/>
</HBox>
