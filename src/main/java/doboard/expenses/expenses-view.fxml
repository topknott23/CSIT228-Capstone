<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="contentArea" prefHeight="605.0" prefWidth="699.0" spacing="20.0" HBox.hgrow="ALWAYS" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="doboard.expenses.ExpensesController">
    <HBox alignment="CENTER_LEFT" styleClass="dashboard-header-bar">
        <Label text="EXPENSES">
            <HBox.margin>
                <Insets top="15.0" />
            </HBox.margin>
            <styleClass>
                <String fx:value="text-xl" />
                <String fx:value="font-bold" />
            </styleClass></Label>
        <Region HBox.hgrow="ALWAYS" />
        <!-- Navigation Tabs -->
        <HBox alignment="CENTER" maxWidth="340.0" prefWidth="340.0" spacing="20.0" style="-fx-border-radius: 0 20 0 30; -fx-background-radius: 0 20 0 30; -fx-border-width: 0 0 1 1;" translateX="20.0">
            <Button mnemonicParsing="false" onAction="#goDashboard" styleClass="nav-tab">
                <graphic>
                    <VBox alignment="CENTER">
                        <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                            <Image url="@../../images/house-chimney.png"/>
                        </ImageView>
                        <Label styleClass="text-ssm" text="Dashboard"/>
                    </VBox>
                </graphic>
            </Button>
            <Button mnemonicParsing="false" onAction="#goChores" styleClass="nav-tab">
                <graphic>
                    <VBox alignment="CENTER">
                        <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                            <Image url="@../../images/broom.png"/>
                        </ImageView>
                        <Label styleClass="text-ssm" text="Chores"/>
                    </VBox>
                </graphic>
            </Button>
            <Button mnemonicParsing="false" styleClass="nav-tab-active">
                <graphic>
                    <VBox alignment="CENTER">
                        <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                            <Image url="@../../images/expense.png"/>
                        </ImageView>
                        <Label styleClass="text-ssm" text="Expenses"/>
                    </VBox>
                </graphic>
            </Button>
            <Button mnemonicParsing="false" onAction="#goSignals" styleClass="nav-tab">
                <graphic>
                    <VBox alignment="CENTER">
                        <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                            <Image url="@../../images/ghost.png"/>
                        </ImageView>
                        <Label styleClass="text-ssm" text="Signals"/>
                    </VBox>
                </graphic>
            </Button>
            <styleClass>
                <String fx:value="bg-white" />
                <String fx:value="br-blue" />
            </styleClass>
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
            <opaqueInsets>
                <Insets />
            </opaqueInsets>
        </HBox>
    </HBox>
    <HBox alignment="CENTER" maxHeight="Infinity" spacing="15.0" VBox.vgrow="ALWAYS">
        <VBox alignment="TOP_CENTER" maxWidth="1.7976931348623157E308" spacing="15.0">
            <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                  style="-fx-padding: 0 0 10 0;" styleClass="card" VBox.vgrow="ALWAYS">
                <Label alignment="BOTTOM_LEFT" maxWidth="Infinity" text="DUE BILL">
                    <styleClass>
                        <String fx:value="font-bold"/>
                        <String fx:value="p-2"/>
                        <String fx:value="text-md"/>
                        <String fx:value="bg-brand-blue1"/>
                        <String fx:value="rounded-lg-t"/>
                    </styleClass>
                </Label>
                <ScrollPane fitToWidth="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                            styleClass="p-2" VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets left="10.0" right="10.0"/>
                    </VBox.margin>
                    <VBox fx:id="dueBillContainer" spacing="5.0">

                    </VBox>
                </ScrollPane>
            </VBox>
            <Separator prefWidth="200.0"/>
            <HBox alignment="TOP_CENTER" spacing="15.0">
                <VBox prefWidth="200.0" spacing="10.0" style="-fx-padding: 0 0 10 0;" styleClass="card">
                    <Label maxWidth="1.7976931348623157E308" text="ADD BILL" VBox.vgrow="ALWAYS">
                        <styleClass>
                            <String fx:value="font-bold"/>
                            <String fx:value="p-2"/>
                            <String fx:value="text-md"/>
                            <String fx:value="bg-brand-blue1"/>
                            <String fx:value="rounded-lg-t"/>
                        </styleClass>
                    </Label>
                    <VBox>
                        <styleClass>
                            <String fx:value="p-2"/>
                            <String fx:value="spacing-2"/>
                        </styleClass>
                        <Label text="Amount:">
                            <styleClass>
                                <String fx:value="text-sm"/>
                                <String fx:value="text-gray"/>
                            </styleClass>
                        </Label>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="₱">
                                <styleClass>
                                    <String fx:value="text-lg"/>
                                    <String fx:value="font-bold"/>
                                </styleClass>
                            </Label>
                            <TextField fx:id="billAmountTextField" prefWidth="171.0" promptText="0.00"/>
                        </HBox>
                    </VBox>
                    <VBox alignment="CENTER" spacing="10.0">
                        <ComboBox fx:id="purposeComboBox" prefWidth="150.0"
                                  promptText="Select purpose..."/>
                        <Button onAction="#splitBill" styleClass="btn-action"
                                text="Split Bill"/>
                    </VBox>
                </VBox>
                <VBox maxHeight="1.7976931348623157E308" prefWidth="200.0" style="-fx-padding: 0 0 10 0;"
                      styleClass="card" HBox.hgrow="ALWAYS">
                    <Label maxWidth="1.7976931348623157E308" text="PROCESSED BILL" VBox.vgrow="ALWAYS">
                        <styleClass>
                            <String fx:value="font-bold"/>
                            <String fx:value="p-2"/>
                            <String fx:value="text-md"/>
                            <String fx:value="bg-brand-blue1"/>
                            <String fx:value="rounded-lg-t"/>
                        </styleClass>
                    </Label>
                    <ScrollPane fitToWidth="true" maxHeight="1.7976931348623157E308" maxWidth="Infinity"
                                styleClass="p-2" VBox.vgrow="ALWAYS">
                        <VBox.margin>
                            <Insets left="10.0" right="10.0"/>
                        </VBox.margin>
                        <VBox fx:id="processedBillContainer" spacing="5.0">
                        </VBox>
                    </ScrollPane>
                </VBox>
            </HBox>
        </VBox>
        <Separator orientation="VERTICAL" prefHeight="200.0"/>
        <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308">
            <VBox maxHeight="1.7976931348623157E308" style="-fx-padding: 0 0 10 0;" styleClass="card"
                  VBox.vgrow="ALWAYS">
                <Label maxWidth="Infinity" text="TRANSACTION HISTORY">
                    <styleClass>
                        <String fx:value="font-bold"/>
                        <String fx:value="p-2"/>
                        <String fx:value="text-md"/>
                        <String fx:value="bg-brand-blue1"/>
                        <String fx:value="rounded-lg-t"/>
                    </styleClass>
                </Label>
                <ScrollPane fitToWidth="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                            styleClass="p-2" VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets left="10.0" right="10.0"/>
                    </VBox.margin>
                    <VBox fx:id="transactionContainer" spacing="5.0">
                    </VBox>
                </ScrollPane>
            </VBox>
        </VBox>
    </HBox>
    <styleClass>
        <String fx:value="shadow-sm" />
        <String fx:value="rounded-xl" />
        <String fx:value="br-linear-y-b" />
        <String fx:value="bg-gray-light" />
    </styleClass>
    <HBox.margin>
        <Insets />
    </HBox.margin>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" />
    </padding>
</VBox>
