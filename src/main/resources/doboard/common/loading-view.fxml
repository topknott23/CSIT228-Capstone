<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane alignment="CENTER" styleClass="bg-dashboard-canvas" stylesheets="@../../styles/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="doboard.common.LoadingController">
   <children>
      <VBox alignment="CENTER" maxWidth="450.0" maxHeight="400.0" spacing="24.0" styleClass="glass-panel">
         <padding>
            <Insets top="40.0" bottom="40.0" left="40.0" right="40.0" />
         </padding>
         <children>
            <Label text="MAINTENANT" styleClass="text-xl, font-bold, text-brand-blue" style="-fx-font-size: 38px; -fx-letter-spacing: 2px;" />

            <ImageView fitHeight="110.0" fitWidth="110.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../images/logo.png" />
               </image>
            </ImageView>

            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <Label text="Preparing your workspace..." styleClass="text-md, font-bold, text-dark" />
                  <Label fx:id="statusLabel" text="Initializing database connection..." styleClass="text-sm, text-gray" />
               </children>
            </VBox>

            <ProgressBar fx:id="progressBar" prefWidth="280.0" progress="0.25" styleClass="progress-bar-loading" />
         </children>
      </VBox>
   </children>
</StackPane>