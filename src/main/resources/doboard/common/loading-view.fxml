<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" styleClass="bg-brand-blue" stylesheets="@../../styles/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="doboard.common.LoadingController">
   <children>
      <Label text="MAINTENANT" textFill="#ffd94c">
         <font>
            <Font name="System Bold" size="48.0" />
         </font>
      </Label>
      <Label text="Preparing your workspace..." textFill="WHITE">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <ProgressBar fx:id="progressBar" prefWidth="300.0" progress="0.0" style="-fx-accent: #FFD94C;" />
      <Label fx:id="statusLabel" text="Initializing..." textFill="#cedbf3">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
   </children>
   <padding>
      <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
   </padding>
</VBox>
