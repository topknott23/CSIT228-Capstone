<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="task-item" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <Region minWidth="-Infinity" prefWidth="4.0" style="-fx-background-color: #406AAF;" VBox.vgrow="ALWAYS" />

    <VBox alignment="CENTER_LEFT" spacing="2.0">
        <Label id="titleLabel" styleClass="font-bold, text-md" text="Groceries" />
        <Label id="dateLabel" styleClass="text-sm, text-gray" text="2026-05-18" />
    </VBox>

    <Region HBox.hgrow="ALWAYS" />

    <Label id="amountLabel" alignment="CENTER_RIGHT" minWidth="-Infinity" prefWidth="80.0" styleClass="font-bold, text-md" style="-fx-text-fill: #d9534f;" text="-₱0.00" />

    <Button id="undoButton" minWidth="-Infinity" styleClass="btn-small" text="Undo">
        <HBox.margin>
            <Insets right="5.0" />
        </HBox.margin>
    </Button>

</HBox>