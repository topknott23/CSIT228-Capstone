<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="doboard.expenses.ArchivedBillsController">
    <VBox spacing="15.0" styleClass="card" VBox.vgrow="ALWAYS">
        <Label text="MY PAYMENT HISTORY">
            <styleClass>
                <String fx:value="font-bold" />
                <String fx:value="text-lg" />
                <String fx:value="text-brand-blue" />
            </styleClass>
        </Label>

        <Label text="A complete log of all utility bills and expenses you have settled." style="-fx-text-fill: #666; -fx-font-size: 13px;" />

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
            <VBox fx:id="logsContainer" spacing="10.0" />
        </ScrollPane>
    </VBox>
</VBox>