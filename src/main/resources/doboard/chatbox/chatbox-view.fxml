<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600.0" prefWidth="650.0" styleClass="bg-white, rounded-xl, shadow-md"
      stylesheets="@../../styles/styles.css" xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="doboard.chatbox.ChatController"><!-- 1. GROUP CHAT HEADER -->
    <HBox alignment="CENTER_LEFT" prefHeight="65.0" styleClass="bg-brand-blue, p-4, rounded-xl-t">
        <VBox alignment="CENTER_LEFT" spacing="2">
            <!-- Accessible IDs for dynamic naming via DormDAO -->
            <Label fx:id="dormNameLabel" styleClass="text-white, font-bold, text-lg"
                   text="Loading Room Workspace..."/>
            <Label fx:id="dormCodeLabel" styleClass="text-brand-yellow, text-sm" text="Group Chat"/>
        </VBox>
        <Pane HBox.hgrow="ALWAYS"/>
        <Label styleClass="text-white, text-sm, font-bold" text="Room Members"/>
    </HBox>

    <!-- 2. MAIN WORKSPACE CONTAINER (SPLIT DESIGN) -->
    <HBox spacing="10" VBox.vgrow="ALWAYS"><!-- LEFT PANE: CHAT STREAM & INPUT CONTAINER -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="10.0" left="10.0" top="10.0"/>
            </padding>
            <ListView fx:id="chatListView" styleClass="list-view" VBox.vgrow="ALWAYS"/>

            <!-- INPUT & SEND FOOTER -->
            <HBox alignment="CENTER" prefHeight="60.0" spacing="10" styleClass="bg-gray-light, p-2, rounded-xl">
                <TextField fx:id="messageInput" onAction="#handleSendMessage"
                           promptText="Message your dormmates..." styleClass="input-pill, text-md"
                           HBox.hgrow="ALWAYS"/>
                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleSendMessage"
                        prefHeight="38.0" prefWidth="85.0" styleClass="btn-primary" text="Send"/>
            </HBox>
        </VBox>

        <!-- RIGHT PANE: DORM MEMBERS SIDEBAR -->
        <VBox prefWidth="200.0" spacing="8" styleClass="p-2">
            <padding>
                <Insets bottom="10.0" right="10.0" top="10.0"/>
            </padding>
            <ListView fx:id="membersListView" styleClass="list-view" VBox.vgrow="ALWAYS"/>
        </VBox>

    </HBox>

</VBox>
