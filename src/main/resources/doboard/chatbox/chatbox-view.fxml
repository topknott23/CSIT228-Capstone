<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="550.0" prefWidth="400.0" styleClass="bg-white, rounded-xl, shadow-md" stylesheets="@style.css" xmlns="http://javafx.scene.com/javafx/17" xmlns:fx="http://javafx.scene.com/fxml/1" fx:controller="ChatController">
    <children>

        <!-- 1. CHAT HEADER -->
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" styleClass="bg-brand-blue, p-4, rounded-xl-t">
            <children>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <children>
                        <Label styleClass="text-white, font-bold, text-md" text="Maintenant Chat" />
                        <Label styleClass="text-brand-yellow, text-sm" text="Local Network Server" />
                    </children>
                </VBox>
                <Pane HBox.hgrow="ALWAYS" />
                <!-- Connection status indicator -->
                <Label styleClass="text-white, text-sm, font-bold" text="● Connected" />
            </children>
        </HBox>

        <!-- 2. CHAT HISTORY VIEW -->
        <VBox styleClass="p-4" VBox.vgrow="ALWAYS">
            <children>
                <ListView fx:id="chatListView" prefHeight="200.0" prefWidth="200.0" styleClass="list-view" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>

        <!-- 3. INPUT & SEND FOOTER -->
        <HBox alignment="CENTER" prefHeight="70.0" styleClass="bg-gray-light, p-4, rounded-xl" spacing="10">
            <children>
                <TextField fx:id="messageInput" onAction="#handleSendMessage" promptText="Type a message..." styleClass="input-pill, text-md" HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleSendMessage" prefHeight="38.0" prefWidth="85.0" styleClass="btn-primary" text="Send" />
            </children>
            <VBox.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" />
            </VBox.margin>
        </HBox>

    </children>
</VBox>