<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="contentArea" spacing="20.0" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="doboard.signals.SignalsController">
    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <VBox prefWidth="450.0" style="-fx-padding: 0 0 10 0;" styleClass="card" HBox.hgrow="ALWAYS">
            <Label maxWidth="Infinity" text="SIGNAL HISTORY">
                <styleClass>
                    <String fx:value="font-bold"/>
                    <String fx:value="p-2"/>
                    <String fx:value="text-md"/>
                    <String fx:value="bg-brand-blue1"/>
                    <String fx:value="rounded-lg-t"/>
                </styleClass>
            </Label>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" styleClass="p-2" VBox.vgrow="ALWAYS">
                <VBox.margin>
                    <Insets left="10.0" right="10.0"/>
                </VBox.margin>
                <VBox fx:id="signalLogContainer" spacing="10.0">
                </VBox>
            </ScrollPane>
        </VBox>

        <VBox prefWidth="250.0" spacing="20.0" HBox.hgrow="NEVER">

            <VBox spacing="10.0" style="-fx-padding: 0 0 10 0;" styleClass="card">
                <Label maxWidth="1.7976931348623157E308" text="NUDGE TENANTS" VBox.vgrow="ALWAYS">
                    <styleClass>
                        <String fx:value="font-bold"/>
                        <String fx:value="p-2"/>
                        <String fx:value="text-md"/>
                        <String fx:value="bg-brand-blue1"/>
                        <String fx:value="rounded-lg-t"/>
                    </styleClass>
                </Label>
                <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets left="10.0" right="10.0"/>
                    </padding>
                    <ComboBox fx:id="complaintComboBox" maxWidth="1.7976931348623157E308" promptText="Select Complaint">
                        <VBox.margin>
                            <Insets bottom="10.0"/>
                        </VBox.margin>
                    </ComboBox>
                    <ComboBox fx:id="tenantComboBox" maxWidth="1.7976931348623157E308" promptText="Select Tenant">
                        <VBox.margin>
                            <Insets bottom="10.0"/>
                        </VBox.margin>
                    </ComboBox>
                    <Separator prefWidth="200.0"/>
                    <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Number of Nudges:"/>
                    <HBox alignment="CENTER" spacing="5.0">
                        <VBox.margin>
                            <Insets bottom="20.0"/>
                        </VBox.margin>
                        <RadioButton fx:id="nudgeCount1" mnemonicParsing="false" text="1"/>
                        <RadioButton fx:id="nudgeCount2" mnemonicParsing="false" text="2"/>
                        <RadioButton fx:id="nudgeCount5" mnemonicParsing="false" text="5"/>
                        <RadioButton fx:id="nudgeCount10" mnemonicParsing="false" text="10"/>
                    </HBox>
                    <Button mnemonicParsing="false" onAction="#sendNudge" styleClass="btn-action" text="Send Signal"/>
                </VBox>
            </VBox>

            <VBox spacing="10.0" style="-fx-padding: 0 0 10 0;" styleClass="card">
                <Label maxWidth="1.7976931348623157E308" text="NOTIFICATIONS DND">
                    <styleClass>
                        <String fx:value="font-bold"/>
                        <String fx:value="p-2"/>
                        <String fx:value="text-md"/>
                        <String fx:value="bg-brand-blue1"/>
                        <String fx:value="rounded-lg-t"/>
                    </styleClass>
                </Label>
                <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets left="10.0" right="10.0"/>
                    </VBox.margin>
                    <ComboBox fx:id="reasonComboBox" maxWidth="1.7976931348623157E308" promptText="Select Reason">
                        <VBox.margin>
                            <Insets bottom="10.0"/>
                        </VBox.margin>
                    </ComboBox>
                    <Separator prefWidth="200.0"/>
                    <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Hours:"/>
                    <HBox alignment="CENTER" spacing="5.0">
                        <VBox.margin>
                            <Insets bottom="20.0"/>
                        </VBox.margin>
                        <RadioButton fx:id="dndHour2" mnemonicParsing="false" text="2"/>
                        <RadioButton fx:id="dndHour3" mnemonicParsing="false" text="3"/>
                        <RadioButton fx:id="dndHour4" mnemonicParsing="false" text="4"/>
                        <RadioButton fx:id="dndHour8" mnemonicParsing="false" text="8"/>
                    </HBox>
                    <Button mnemonicParsing="false" onAction="#disableNotifs" styleClass="btn-action" text="Disable"/>
                </VBox>
            </VBox>

        </VBox>
    </HBox>
</VBox>