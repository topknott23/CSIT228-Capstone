<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" prefHeight="720.0" prefWidth="1080.0" styleClass="bg-dashboard-canvas" stylesheets="@../../styles/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="doboard.dashboard.DashboardController">
    <BorderPane>

        <top>
            <fx:include fx:id="embeddedTitleBar" source="../common/title-bar.fxml" />
        </top>

        <center>
            <HBox maxHeight="Infinity" maxWidth="Infinity" spacing="24.0" style="-fx-background-color: transparent;">

                <VBox minWidth="-Infinity" prefWidth="235.0" spacing="12.0">
                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-width: 0 0 1 0; -fx-border-color: rgba(255, 255, 255, 0.45);">
                        <Label fx:id="usernameVal" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #0F172A;" text="Username" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-text-fill: red; -fx-background-color: rgba(239, 68, 68, 0.1); -fx-border-color: rgba(239, 68, 68, 0.25); -fx-padding: 6px 14px; -fx-cursor: hand;" text="Logout">
                            <styleClass>
                                <String fx:value="text-sm" />
                                <String fx:value="btn-secondary" />
                                <String fx:value="font-bold" />
                                <String fx:value="rounded-md" />
                            </styleClass>
                        </Button>
                        <styleClass>
                            <String fx:value="rounded-xl-t" />
                        </styleClass>
                        <padding>
                            <Insets bottom="12.0" left="16.0" right="12.0" top="12.0" />
                        </padding>
                    </HBox>

                    <StackPane VBox.vgrow="ALWAYS">
                        <VBox fx:id="tenantSidebar" prefHeight="200.0" prefWidth="100.0" spacing="6.0">
                            <padding>
                                <Insets left="8.0" right="8.0" top="8.0" />
                            </padding>
                            <Button fx:id="sideProfile" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleProfileSettings" styleClass="sidebar-btn" text="Profile &amp; Personal Info" />
                            <Button fx:id="sideDormmates" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleDormmatesList" styleClass="sidebar-btn" text="Dormmates" />
                            <Button fx:id="sideArchivedBills" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleArchivedBills" styleClass="sidebar-btn" text="Archived Bills" />
                            <Button fx:id="sideChat" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleOpenDormChat" styleClass="sidebar-btn" text="Dorm Chat" />
                        </VBox>

                        <VBox fx:id="adminSidebar" prefHeight="200.0" prefWidth="100.0" spacing="6.0" visible="false" managed="false">
                            <padding>
                                <Insets left="8.0" right="8.0" top="8.0" />
                            </padding>
                            <Button fx:id="sideAdminOverview" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleAdminDashboard" styleClass="sidebar-btn" text="Overview" />
                            <Button fx:id="sideAdminManage" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleManageDormsAdmin" styleClass="sidebar-btn" text="Manage Dorms" />
                            <Button fx:id="sideAdminHistory" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleBillHistoryAdmin" styleClass="sidebar-btn" text="Bill History" />
                        </VBox>
                    </StackPane>

                    <styleClass>
                        <String fx:value="glass-panel" />
                    </styleClass>
                    <padding>
                        <Insets bottom="12.0" />
                    </padding>
                </VBox>

                <VBox maxWidth="Infinity" prefHeight="605.0" prefWidth="699.0" spacing="20.0" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" styleClass="dashboard-header-bar">
                        <padding>
                            <Insets bottom="4.0" left="4.0" right="4.0" top="12.0" />
                        </padding>
                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                            <Label fx:id="currentScreenTitleLabel" text="DASHBOARD" style="-fx-text-fill: #0F172A;">
                                <styleClass>
                                    <String fx:value="text-xl" />
                                    <String fx:value="font-bold" />
                                </styleClass>
                            </Label>

                            <HBox fx:id="workspaceBadgeContainer" alignment="CENTER_LEFT" spacing="6.0">
                                <Label fx:id="tenantDormNameLabel" style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 13px;" text="Loading Workspace..." />
                                <Label style="-fx-text-fill: rgba(15, 23, 42, 0.2);" text="•" />
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px;" text="Join Code:" />
                                <Label fx:id="tenantJoinCodeLabel" onMouseClicked="#copyCode" onMouseEntered="#renderCopyCodeBoxTooltip" onMouseExited="#renderCopyCodeBoxTooltip" style="-fx-font-weight: bold; -fx-text-fill: #406AAF; -fx-font-size: 13px; -fx-cursor: hand;" text="------" />
                            </HBox>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <HBox fx:id="navBarContainer" alignment="BOTTOM_CENTER" spacing="20.0">
                            <Button fx:id="navDashboard" mnemonicParsing="false" onAction="#goDashboard" styleClass="nav-tab-active">
                                <graphic>
                                    <VBox alignment="CENTER" spacing="4.0">
                                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                            <Image url="@../../images/house-chimney.png" />
                                        </ImageView>
                                        <Label styleClass="text-ssm" text="Dashboard" style="-fx-text-fill: #406AAF;" />
                                    </VBox>
                                </graphic>
                            </Button>
                            <Button fx:id="navChores" mnemonicParsing="false" onAction="#goChores" styleClass="nav-tab">
                                <graphic>
                                    <VBox alignment="CENTER" spacing="4.0">
                                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                            <Image url="@../../images/broom.png" />
                                        </ImageView>
                                        <Label styleClass="text-ssm" text="Chores" style="-fx-text-fill: #475569;" />
                                    </VBox>
                                </graphic>
                            </Button>
                            <Button fx:id="navExpenses" mnemonicParsing="false" onAction="#goExpenses" styleClass="nav-tab">
                                <graphic>
                                    <VBox alignment="CENTER" spacing="4.0">
                                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                            <Image url="@../../images/expense.png" />
                                        </ImageView>
                                        <Label styleClass="text-ssm" text="Expenses" style="-fx-text-fill: #475569;" />
                                    </VBox>
                                </graphic>
                            </Button>
                            <Button fx:id="navSignals" mnemonicParsing="false" onAction="#goSignals" styleClass="nav-tab">
                                <graphic>
                                    <VBox alignment="CENTER" spacing="4.0">
                                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                            <Image url="@../../images/ghost.png" />
                                        </ImageView>
                                        <Label styleClass="text-ssm" text="Signals" style="-fx-text-fill: #475569;" />
                                    </VBox>
                                </graphic>
                            </Button>
                        </HBox>
                    </HBox>

                    <VBox fx:id="contentArea" spacing="20.0" VBox.vgrow="ALWAYS" />

                    <styleClass>
                        <String fx:value="glass-panel" />
                    </styleClass>
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" />
                    </padding>
                </VBox>

                <BorderPane.margin>
                    <Insets bottom="24.0" left="32.0" right="32.0" top="16.0" />
                </BorderPane.margin>
            </HBox>
        </center>
    </BorderPane>
</StackPane>