<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="contentArea" spacing="20.0" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="doboard.dashboard.AdminContentController">
    <VBox alignment="TOP_CENTER" maxWidth="Infinity" spacing="15.0" VBox.vgrow="ALWAYS">
        <Label alignment="CENTER" maxWidth="Infinity" style="-fx-text-fill: #555;" text="NOTIFICATIONS">
            <styleClass>
                <String fx:value="font-bold" />
                <String fx:value="text-lg" />
            </styleClass>
        </Label>
        <HBox maxWidth="Infinity" spacing="15.0">
            <VBox maxWidth="1.7976931348623157E308" prefWidth="319.0" style="-fx-padding: 0 0 10 0;" styleClass="card" HBox.hgrow="ALWAYS">
                <Label alignment="BOTTOM_LEFT" maxWidth="Infinity" text="SYSTEM FEED">
                    <styleClass>
                        <String fx:value="font-bold" />
                        <String fx:value="p-2" />
                        <String fx:value="text-md" />
                        <String fx:value="bg-brand-blue1" />
                        <String fx:value="rounded-lg-t" />
                    </styleClass></Label>
                <ScrollPane fitToWidth="true" maxWidth="Infinity" prefHeight="100.0" styleClass="p-2">
                    <VBox.margin>
                        <Insets left="10.0" right="10.0" />
                    </VBox.margin>
                    <VBox fx:id="systemNotifContainer" spacing="5.0">

                    </VBox>
                </ScrollPane>
                <HBox.margin>
                    <Insets />
                </HBox.margin>
            </VBox>
            <VBox maxWidth="1.7976931348623157E308" prefWidth="319.0" style="-fx-padding: 0 0 10 0;" styleClass="card" HBox.hgrow="ALWAYS">
                <Label maxWidth="Infinity" text="MAINTENANCE SIGNALS">
                    <styleClass>
                        <String fx:value="font-bold" />
                        <String fx:value="p-2" />
                        <String fx:value="text-md" />
                        <String fx:value="bg-brand-blue1" />
                        <String fx:value="rounded-lg-t" />
                    </styleClass>
                </Label>
                <ScrollPane fitToWidth="true" maxWidth="Infinity" prefHeight="100.0" styleClass="p-2">
                    <VBox.margin>
                        <Insets left="10.0" right="10.0" />
                    </VBox.margin>
                    <VBox fx:id="signalsNotifContainer" spacing="5.0">

                    </VBox>
                </ScrollPane>
            </VBox>
        </HBox>

        <Separator />

        <Label alignment="CENTER" maxWidth="Infinity" style="-fx-text-fill: #555;" text="UTILITIES">
            <styleClass>
                <String fx:value="font-bold" />
                <String fx:value="text-lg" />
            </styleClass>
        </Label>

        <HBox alignment="CENTER" maxHeight="Infinity" spacing="15.0" VBox.vgrow="ALWAYS">
         <HBox alignment="TOP_CENTER" spacing="15.0">
            <children>
                  <VBox prefHeight="313.0" prefWidth="280.0" style="-fx-padding: 0 0 10 0;" styleClass="card" HBox.hgrow="ALWAYS">
                      <Label alignment="BOTTOM_LEFT" maxWidth="Infinity" text="MAINTENANCE VIEW">
                          <styleClass>
                              <String fx:value="font-bold" />
                              <String fx:value="p-2" />
                              <String fx:value="text-md" />
                              <String fx:value="bg-brand-blue1" />
                              <String fx:value="rounded-lg-t" />
                          </styleClass>
                      </Label>
                      <TableView fx:id="maintenanceTableView" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                          <columns>
                              <TableColumn fx:id="idColumn" prefWidth="55.0" text="ID" />
                              <TableColumn fx:id="unitColumn" prefWidth="55.0" text="Unit" />
                              <TableColumn fx:id="issueColumn" prefWidth="150.0" text="Issue" />
                              <TableColumn fx:id="actionColumn" prefWidth="75.0" text="Action" />
                          </columns>
                          <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                          </columnResizePolicy>
                      </TableView>
                  </VBox>

                  <VBox alignment="TOP_CENTER" prefWidth="250.0" spacing="10.0" style="-fx-padding: 0 0 10 0;" styleClass="card">
                      <Label alignment="BOTTOM_LEFT" maxWidth="Infinity" text="BILLING">
                          <styleClass>
                              <String fx:value="font-bold" />
                              <String fx:value="p-2" />
                              <String fx:value="text-md" />
                              <String fx:value="bg-brand-blue1" />
                              <String fx:value="rounded-lg-t" />
                          </styleClass>
                      </Label>
                      <VBox alignment="CENTER" spacing="5.0" VBox.vgrow="ALWAYS">
                          <VBox spacing="4.0">
                              <Label styleClass="text-sm, text-gray" text="Add Bill:" />
                              <HBox alignment="CENTER_LEFT">
                                  <Label styleClass="text-lg, font-bold" text="₱" />
                                  <TextField fx:id="rentAmountField" maxWidth="Infinity" promptText="0.00" HBox.hgrow="ALWAYS" />
                              </HBox>
                          </VBox>
                     <Separator prefWidth="200.0">
                        <VBox.margin>
                           <Insets bottom="5.0" top="5.0" />
                        </VBox.margin>
                     </Separator>
                          <TextField fx:id="billPurposeField" promptText="Enter Bill Purpose (e.g., Rent, Water)" styleClass="input-field" />
                          <Button fx:id="selectRecipientBtn" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleSelectRecipient" style="-fx-background-color: #E7E7E7; -fx-padding: 8px 12px; -fx-text-fill: #555;" styleClass="rounded-md" text="Select Recipient" />
                          <Region prefHeight="20.0" />
                          <Button onAction="#handleCreateAdminBill" styleClass="btn-primary" text="Add Bill" />
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                      </VBox>
                  </VBox>
                <VBox alignment="TOP_CENTER" prefWidth="250.0" spacing="10.0" style="-fx-padding: 0 0 10 0;" styleClass="card">
                    <Label alignment="BOTTOM_LEFT" maxWidth="Infinity" text="DORM">
                        <styleClass>
                            <String fx:value="font-bold" />
                            <String fx:value="p-2" />
                            <String fx:value="text-md" />
                            <String fx:value="bg-brand-blue1" />
                            <String fx:value="rounded-lg-t" />
                        </styleClass>
                    </Label>
                    <VBox alignment="CENTER" spacing="15.0" VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                        <Label style="-fx-text-fill: #666; -fx-font-size: 12px;" text="Manage properties and generate new join codes for tenants." textAlignment="CENTER" wrapText="true" />
                        <Region VBox.vgrow="ALWAYS" />
                        <Button maxWidth="Infinity" onAction="#handleCreateWorkspace" style="-fx-padding: 10px;" styleClass="btn-primary" text="Create New Dorm" />
                    </VBox>
                </VBox>
            </children>
         </HBox>
        </HBox>
    </VBox>
</VBox>
