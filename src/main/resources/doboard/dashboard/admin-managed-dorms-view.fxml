    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-padding: 0; -fx-background: transparent;">
        <VBox fx:id="dormsListContainer" spacing="10.0" />
    </ScrollPane>
</VBox>