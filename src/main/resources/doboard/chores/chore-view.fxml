<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="contentArea" spacing="20.0" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="doboard.chores.ChoreController">
    <VBox prefHeight="200.0" prefWidth="100.0">
        <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-padding: 0 0 10 0;"
              styleClass="card" VBox.vgrow="ALWAYS">
            <Label alignment="BOTTOM_LEFT" maxWidth="Infinity" text="MONTHLY CHORES DONE">
                <styleClass>
                    <String fx:value="font-bold"/>
                    <String fx:value="p-2"/>
                    <String fx:value="text-md"/>
                    <String fx:value="bg-brand-blue1"/>
                    <String fx:value="rounded-lg-t"/>
                </styleClass>
            </Label>
            <ScrollPane fitToWidth="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                        styleClass="p-2" VBox.vgrow="ALWAYS">
                <VBox.margin>
                    <Insets left="10.0" right="10.0"/>
                </VBox.margin>
                <VBox fx:id="usersContainer" spacing="5.0">

                </VBox>
            </ScrollPane>
        </VBox>
    </VBox>
        <Separator prefWidth="200.0" />
    <HBox alignment="CENTER" maxHeight="Infinity" spacing="15.0" VBox.vgrow="ALWAYS">
        <HBox alignment="TOP_CENTER" spacing="15.0">
            <VBox prefWidth="200.0" spacing="10.0" style="-fx-padding: 0 0 10 0;" styleClass="card">
                <Label maxWidth="1.7976931348623157E308" text="CHORE MANAGER" VBox.vgrow="ALWAYS">
                    <styleClass>
                        <String fx:value="font-bold"/>
                        <String fx:value="p-2"/>
                        <String fx:value="text-md"/>
                        <String fx:value="bg-brand-blue1"/>
                        <String fx:value="rounded-lg-t"/>
                    </styleClass>
                </Label>
                <VBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
                    <Label text="Select Operation:">
                        <styleClass>
                            <String fx:value="text-sm"/>
                            <String fx:value="text-gray"/>
                        </styleClass>
                    </Label>
                    <Button fx:id="addChoreBtn" onAction="#addChore" prefWidth="100.0"
                            styleClass="btn-action" text="Add Chore"/>
                    <Button fx:id="updateChoreBtn" onAction="#updateChore" prefWidth="100.0"
                            styleClass="btn-action" text="Update Chore"/>
                    <Button fx:id="removeChoreBtn" onAction="#removeChore" prefWidth="100.0"
                            styleClass="btn-action" text="Remove Chore"/>
                </VBox>
            </VBox>
        </HBox>
    </HBox>
</VBox>
