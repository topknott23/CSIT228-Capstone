<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="doboard.chores.AddChoreDialogController">
   <children>
      <Label text="Add New Chore">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </VBox.margin>
      </Label>
      <GridPane hgap="10.0" vgap="10.0">
         <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="200.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
         </rowConstraints>
         <children>
            <Label text="Title:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="titleField" promptText="Enter chore title" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="descriptionField" promptText="Enter chore description" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Frequency:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <ComboBox fx:id="frequencyComboBox" prefWidth="150.0" promptText="Select frequency" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Due Date:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <DatePicker fx:id="dueDatePicker" promptText="Select due date" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label text="Assign to Users:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <ListView fx:id="usersListView" prefHeight="100.0" GridPane.columnIndex="1" GridPane.rowIndex="4" GridPane.rowSpan="2" />
         </children>
         <VBox.margin>
            <Insets bottom="10.0" left="20.0" right="20.0" top="0.0" />
         </VBox.margin>
      </GridPane>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button fx:id="cancelButton" mnemonicParsing="false" text="Cancel" />
            <Button fx:id="addButton" mnemonicParsing="false" styleClass="primary-button" text="Add Chore" />
         </children>
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>