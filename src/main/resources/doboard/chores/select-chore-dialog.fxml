<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="doboard.chores.SelectChoreDialogController">
   <children>
      <Label text="Select Chore">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </VBox.margin>
      </Label>
      <Label text="Choose a chore to edit or delete:">
         <VBox.margin>
            <Insets bottom="10.0" left="20.0" right="20.0" top="0.0" />
         </VBox.margin>
      </Label>
      <ListView fx:id="choresListView" prefHeight="200.0">
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="0.0" />
         </VBox.margin>
      </ListView>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button fx:id="cancelButton" onAction="#handleCancel" mnemonicParsing="false" text="Cancel" />
            <Button fx:id="selectButton" onAction="#handleSelect" mnemonicParsing="false" styleClass="primary-button" text="Select" />
         </children>
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="0.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>