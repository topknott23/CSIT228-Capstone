<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane style="-fx-background-color: transparent; -fx-padding: 20;" stylesheets="@../../styles/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="doboard.dorm.DormSetupController">

    <VBox prefWidth="420.0" spacing="20.0" style="-fx-border-color: #cacaca; -fx-border-radius: 15px;">
        <styleClass>
            <String fx:value="bg-white" />
            <String fx:value="p-6" />
            <String fx:value="rounded-xl" />
            <String fx:value="shadow-md" />
        </styleClass>

        <VBox spacing="5.0">
            <Label text="Dorm Setup">
                <styleClass>
                    <String fx:value="text-xl" />
                    <String fx:value="font-bold" />
                    <String fx:value="text-brand-blue" />
                </styleClass>
            </Label>
            <Label style="-fx-text-fill: #666;" text="Join your roommates in your shared space." />
            <Separator />
        </VBox>

        <VBox fx:id="createSection" managed="false" spacing="10.0" style="-fx-background-color: #F9F9F9; -fx-padding: 15px;" styleClass="rounded-lg" visible="false">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #555;" text="Create New Dorm (Landlord Only)" />
            <TextField fx:id="dormNameField" promptText="e.g., Baker Hall 302" styleClass="input-pill" />
            <Button maxWidth="Infinity" onAction="#handleCreateDorm" style="-fx-padding: 8px;" styleClass="btn-primary" text="Create &amp; Register" />
        </VBox>

        <HBox fx:id="orSeparator" alignment="CENTER" managed="false" spacing="10.0" visible="false">
            <Separator HBox.hgrow="ALWAYS" />
            <Label style="-fx-text-fill: #999; -fx-font-weight: bold; -fx-font-size: 12px;" text="OR" />
            <Separator HBox.hgrow="ALWAYS" />
        </HBox>

        <VBox spacing="10.0" style="-fx-background-color: #F9F9F9; -fx-padding: 15px;" styleClass="rounded-lg">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #555;" text="Join Existing Dorm" />
            <TextField fx:id="joinCodeField" promptText="Enter 6-Digit Code" styleClass="input-pill" />
            <Button maxWidth="Infinity" onAction="#handleJoinDorm" style="-fx-padding: 8px; -fx-text-fill: #406AAF; -fx-font-weight: bold;" styleClass="btn-action" text="Join Dorm" />
        </VBox>

        <Label fx:id="statusLabel" alignment="CENTER" maxWidth="Infinity" onMouseClicked="#copyCode" onMouseEntered="#renderCopyCodeBoxTooltip" onMouseExited="#renderCopyCodeBoxTooltip" style="-fx-font-size: 12px; -fx-font-weight: bold;" wrapText="true" />

        <HBox alignment="CENTER_RIGHT">
            <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" text="Cancel">
                <styleClass>
                    <String fx:value="btn-secondary" />
                    <String fx:value="font-bold" />
                </styleClass>
            </Button>
        </HBox>
    </VBox>
</StackPane>
