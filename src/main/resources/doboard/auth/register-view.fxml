<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane fx:id="rootPane" prefHeight="600.0" prefWidth="800.0" stylesheets="@../../styles/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="doboard.auth.RegisterController">
    <ImageView fx:id="backgroundView" pickOnBounds="true">
        <Image url="@../../images/background.png" />
    </ImageView>

    <fx:include fx:id="embeddedTitleBar" source="../common/title-bar.fxml" />

    <VBox alignment="CENTER" maxHeight="400.0" maxWidth="400.0" prefWidth="400.0" styleClass="card">
        <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="20.0" />
        </padding>
        <Label text="Create an Account">
            <styleClass>
                <String fx:value="text-xl" />
                <String fx:value="font-bold" />
                <String fx:value="text-dark" />
            </styleClass>
        </Label>

        <VBox styleClass="spacing-2">
            <Label text="Email:">
                <VBox.margin><Insets left="10.0" /></VBox.margin>
                <styleClass>
                    <String fx:value="font-bold" />
                    <String fx:value="text-sm" />
                </styleClass>
            </Label>
            <TextField fx:id="emailField" promptText="Enter your email" styleClass="input-pill" />
            <VBox.margin><Insets top="10.0" /></VBox.margin>
        </VBox>

        <VBox styleClass="spacing-2">
            <VBox.margin><Insets top="20.0" /></VBox.margin>
            <Label text="Full Name:">
                <VBox.margin><Insets left="10.0" /></VBox.margin>
                <styleClass>
                    <String fx:value="font-bold" />
                    <String fx:value="text-sm" />
                </styleClass>
            </Label>
            <TextField fx:id="fullNameField" promptText="Enter full name" styleClass="input-pill" />
        </VBox>

        <VBox styleClass="spacing-2">
            <VBox.margin><Insets top="20.0" /></VBox.margin>
            <Label text="Username:">
                <VBox.margin><Insets left="10.0" /></VBox.margin>
                <styleClass>
                    <String fx:value="font-bold" />
                    <String fx:value="text-sm" />
                </styleClass>
            </Label>
            <TextField fx:id="usernameField" promptText="Enter username" styleClass="input-pill" />
        </VBox>

        <VBox styleClass="spacing-2">
            <Label text="Password:">
                <VBox.margin><Insets left="10.0" /></VBox.margin>
                <styleClass>
                    <String fx:value="font-bold" />
                    <String fx:value="text-sm" />
                </styleClass>
            </Label>
            <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="input-pill" />
            <VBox.margin><Insets top="20.0" /></VBox.margin>
        </VBox>

        <Button fx:id="registerButton" onAction="#handleRegister" prefWidth="180.0" styleClass="btn-primary" text="Create Account">
            <VBox.margin><Insets top="40.0" /></VBox.margin>
            <font><Font size="14.0" /></font>
        </Button>

        <HBox alignment="CENTER" spacing="5.0">
            <Label text="Already have an account?" />
            <Hyperlink onAction="#goLogin" text="Login" />
            <padding><Insets top="10.0" /></padding>
        </HBox>
    </VBox>
</StackPane>
